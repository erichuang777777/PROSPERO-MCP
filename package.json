{
  "name": "prospero-mcp",
  "version": "0.2.0",
  "description": "MCP server for searching PROSPERO protocols",
  "type": "module",
  "main": "dist/server.js",
  "files": [
    "dist/",
    "README.md",
    "FIRST_RUN.md",
    "SECURITY.md",
    "CHANGELOG.md",
    "docs/",
    "skills/",
    "templates/",
    "PROSPERO_REGISTRATION_WORKBOOK.md"
  ],
  "bin": {
    "prospero": "dist/cli.js",
    "prospero-mcp": "dist/server.js",
    "prospero-mcp-setup": "dist/setup.js",
    "prospero-mcp-login": "dist/prospero-login.js",
    "prospero-mcp-install-skill": "dist/install-skill.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean:dist": "node scripts/clean-dist.mjs",
    "build:release": "npm run clean:dist && tsc -p tsconfig.release.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx src/server.ts",
    "cli": "tsx src/cli.ts",
    "login:prospero": "tsx src/prospero-login.ts",
    "setup:prospero": "tsx src/setup.ts",
    "setup:check": "tsx src/setup.ts --check-only",
    "prepack": "npm test && npm run build:release",
    "release:check": "npm pack --dry-run",
    "release:pack": "npm pack",
    "start": "node dist/server.js",
    "test": "npm run build && tsx --test test/*.test.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.26.0",
    "cheerio": "^1.1.2",
    "clipboardy": "^4.0.0",
    "dotenv": "^17.3.1",
    "mammoth": "^1.12.0",
    "pdf-parse": "^2.4.5",
    "playwright-core": "^1.61.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^25.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "directories": {
    "doc": "docs",
    "test": "test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/erichuang777777/PROSPERO-MCP.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/erichuang777777/PROSPERO-MCP/issues"
  },
  "homepage": "https://github.com/erichuang777777/PROSPERO-MCP#readme"
}
