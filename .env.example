# Optional PROSPERO API configuration. Login tokens do not belong in this file.
PROSPERO_BASE_URL=https://www.crd.york.ac.uk/PROSPERO/api/
PROSPERO_TIMEOUT_MS=10000
PROSPERO_NETWORK_MODE=online
PROSPERO_TOOL_PROFILE=authoring
PROSPERO_RESPONSE_MODE=standard
# PROSPERO_CACHE_DIR=D:/research/.prospero-cache
# PROSPERO_CACHE_TTL_MS=21600000

# Required for reading/writing local research files. Separate multiple roots with ; on Windows or : on Unix.
PROSPERO_ALLOWED_PROTOCOL_DIRS=D:/research
PROSPERO_ALLOWED_OUTPUT_DIRS=D:/research
# PROSPERO_CLIPBOARD_DIR=D:/research/.prospero-clipboard
# PROSPERO_ENABLE_CLIPBOARD=false
# PROSPERO_CLIPBOARD_CLEAR_MS=60000
# PROSPERO_PARSER_TIMEOUT_MS=60000
# PROSPERO_PARSER_MAX_OLD_SPACE_MB=256
# PROSPERO_MAX_EXTRACTED_CHARACTERS=2000000
# PROSPERO_MAX_PDF_PAGES=1000
# Non-Windows only: strong local key for AES-256-GCM protected artifacts. Windows uses current-user DPAPI.
# PROSPERO_ARTIFACT_KEY=

# Optional PubMed enhancement. E-utilities work without an API key at the lower public rate limit.
PUBMED_ENABLED=true
PUBMED_TIMEOUT_MS=15000
NCBI_EUTILS_BASE_URL=https://eutils.ncbi.nlm.nih.gov/entrez/eutils/
NCBI_TOOL=prospero-mcp
# NCBI_EMAIL=researcher@example.org
# NCBI_API_KEY=

# Optional browser override. Leave blank when Chrome or Edge is installed normally.
# PROSPERO_BROWSER_PATH=C:/Program Files/Google/Chrome/Application/chrome.exe

# Recommended: configure an absolute per-user directory in the MCP client.
# PROSPERO_USER_DATA_DIR=C:/Users/your-name/.prospero-mcp-profile

# Guarded writes are disabled by default. Do not enable until a dry-run patch is reviewed.
# PROSPERO_ENABLE_WRITES=false
# PROSPERO_AUDIT_DIR=C:/Users/your-name/.prospero-mcp-audit
# PROSPERO_LOCK_DIR=C:/Users/your-name/.prospero-mcp-locks
